# Outgoing mail for the website forms (api/inquiry.ts).
# Set these in Vercel: Project Settings > Environment Variables.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Optional. Sender address; defaults to SMTP_USER.
SMTP_FROM=
# Optional. Where submissions are delivered; defaults to lift@pcitech.com.ph.
INQUIRY_TO=
