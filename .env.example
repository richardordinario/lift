# Outgoing mail for the website forms (api/inquiry.ts), sent through Resend.
# Set these in Vercel: Project Settings > Environment Variables.

# API key from https://resend.com/api-keys
RESEND_API_KEY=
# Sender. The domain must be verified in Resend (https://resend.com/domains).
RESEND_FROM="LIFT Website <website@pcitech.com.ph>"
# Optional. Where submissions are delivered; defaults to lift@pcitech.com.ph.
INQUIRY_TO=
